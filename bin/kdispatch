#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["click>=8.1"]
# ///
#
# kdispatch — dispatch kata issues to background kwt workspaces running Claude.
#
# For each issue: claim it, create a branch holding one empty "wip" commit (without
# checking anything out), push it, open a draft PR, attach a kwt worktree, start its
# tmux workspace detached, and launch `claude --permission-mode auto` there with the
# issue as the prompt. See `kdispatch --help` for usage.
#
# Re-running is safe: claims, branches, PRs, worktrees and sessions that already
# exist are reused, and Claude is only launched into a pane sitting at a shell prompt.
#
# Branch names and PR titles follow per-repo templates in git config (with --global
# as the fallback), filled from the kata issue: {short_id}, {ref}, {title}, {slug}
# and {meta[key]} for issue metadata (`kata meta set <ref> <key> <value>`):
#   git config kdispatch.branch  '{meta[type]}/{meta[jira]}/{slug}'   # default: {short_id}-{slug}
#   git config kdispatch.prTitle '[{meta[jira]}] {title}'             # default: {title}
#
# KDISPATCH_CLAUDE overrides the command launched in each workspace (default: claude).

import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass, field
from pathlib import Path
from types import SimpleNamespace

import click

SHELLS = {"zsh", "bash", "fish", "sh", "dash", "ksh"}
# Seconds to wait for Claude to replace the shell in a pane, then to stay there.
LAUNCH_TIMEOUT, LAUNCH_SETTLE = 15, 3
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")) / "kdispatch"
# kwt is often only a shell alias to the copy bundled with Ghosthub.
GHOSTHUB_KWT = "/Applications/Ghosthub.app/Contents/Helpers/kwt"
KWT = GHOSTHUB_KWT if not shutil.which("kwt") and os.access(GHOSTHUB_KWT, os.X_OK) else "kwt"


class DispatchError(Exception):
    pass


def run(args: list[str], cwd: Path, *, check: bool = True) -> subprocess.CompletedProcess:
    try:
        proc = subprocess.run(args, cwd=cwd, capture_output=True, text=True, stdin=subprocess.DEVNULL)
    except FileNotFoundError:
        raise DispatchError(f"`{args[0]}` not found on PATH") from None
    if check and proc.returncode != 0:
        detail = (proc.stderr or proc.stdout).strip()
        raise DispatchError(f"`{shlex.join(args)}` failed: {detail}")
    return proc


def out(args: list[str], cwd: Path) -> str:
    return run(args, cwd).stdout.strip()


def log(msg: str) -> None:
    click.echo(msg, err=True)


# ── kata ─────────────────────────────────────────────────────────────────────


@dataclass
class Issue:
    ref: str            # qualified ref when known (project#short), else as given
    short_id: str
    title: str
    status: str
    owner: str | None
    meta: dict = field(default_factory=dict)
    children: list[str] = field(default_factory=list)


def kata_json(args: list[str], cwd: Path) -> dict:
    proc = run(["kata", *args, "--json"], cwd, check=False)
    data: dict = {}
    for stream in (proc.stdout, proc.stderr):
        try:
            data = json.loads(stream)
            break
        except json.JSONDecodeError:
            continue
    if proc.returncode != 0 or "error" in data:
        msg = data.get("error", {}).get("message") or (proc.stderr or proc.stdout).strip()
        raise DispatchError(f"kata {' '.join(args)}: {msg}")
    return data


def load_issue(ref: str, cwd: Path) -> Issue:
    data = kata_json(["show", ref], cwd)
    issue, links = data["issue"], data.get("links") or []
    # Children are links of type "parent" pointing *at* this issue; link ids keep
    # them in creation order, which is how objective children are numbered.
    children = sorted((l for l in links if l.get("type") == "parent" and l["to"]["uid"] == issue["uid"]),
                      key=lambda l: l["id"])
    qualified = next((end["qualified_id"] for l in links for end in (l["from"], l["to"])
                      if end["uid"] == issue["uid"]), ref)
    return Issue(ref=qualified, short_id=issue["short_id"], title=issue["title"], status=issue["status"],
                 owner=issue.get("owner"), meta=issue.get("metadata") or {}, children=[l["from"]["qualified_id"] for l in children])


def kata_actor() -> str:
    return os.environ.get("KATA_AUTHOR") or os.environ.get("USER") or ""


# ── planning ─────────────────────────────────────────────────────────────────


@dataclass
class Target:
    issue: Issue
    branch: str
    pr_title: str
    base: str
    pr_url: str = ""
    session: str = ""
    socket: str = ""
    launched: str = ""   # "launched" | "already running (…)" | ""
    error: str = ""


def render(template: str, issue: Issue) -> str:
    class Meta(dict):
        def __missing__(self, key):
            raise DispatchError(f"{issue.short_id}: template `{template}` needs metadata '{key}' "
                                f"(kata meta set {issue.ref} {key} <value>)")

    slug = re.sub(r"[^a-z0-9 -]", "", issue.title.lower()).strip().replace(" ", "-")
    slug = re.sub(r"-{2,}", "-", slug)[:40].rstrip("-")
    try:
        return template.format(short_id=issue.short_id, ref=issue.ref, title=issue.title, slug=slug,
                               meta=Meta(issue.meta))
    except (KeyError, IndexError, ValueError) as e:
        raise DispatchError(f"bad template `{template}`: {e!r}") from None


def git_config(repo: Path, key: str, default: str) -> str:
    proc = run(["git", "config", "--get", key], repo, check=False)
    return proc.stdout.strip() or default


def parse_selection(raw: str, n: int) -> list[int]:
    if not raw.strip():
        return list(range(n))
    picked: set[int] = set()
    for part in raw.replace(" ", "").split(","):
        lo, _, hi = part.partition("-")
        for i in range(int(lo), int(hi or lo) + 1):
            if not 1 <= i <= n:
                raise ValueError(f"{i} is out of range")
            picked.add(i - 1)
    return sorted(picked)


def pick(issues: list[Issue]) -> list[Issue]:
    for i, issue in enumerate(issues, 1):
        log(f"  {i:>2}. {issue.short_id}  {issue.title}")
    while True:
        raw = click.prompt("Dispatch which? (e.g. 1,3-4; empty = all)", default="",
                           show_default=False, err=True)
        try:
            return [issues[i] for i in parse_selection(raw, len(issues))]
        except ValueError as e:
            log(f"  invalid selection: {e}")


def plan(args, repo: Path, default: str) -> tuple[list[Target], bool, list[str]]:
    """Return (targets in dispatch order with their bases, stacked?, skipped-ref notes)."""
    me = kata_actor()
    skipped: list[str] = []

    if not args.refs:
        if not args.interactive:
            raise DispatchError("no issue refs given (interactive selection needs a terminal)")
        listed = kata_json(["list", "--unowned"], repo).get("issues") or []
        roots = [Issue(ref=i["qualified_id"], short_id=i["short_id"], title=i["title"],
                       status=i["status"], owner=i.get("owner"), meta=i.get("metadata") or {})
                 for i in listed]
        if not roots:
            raise DispatchError("no open, unclaimed issues in this repo's kata project")
    else:
        roots = [load_issue(r, repo) for r in args.refs]
    if len(roots) == 1 and roots[0].children:
        stacked = not args.no_stack
        candidates = [load_issue(c, repo) for c in roots[0].children]
    else:
        stacked = args.stack
        candidates = roots

    issues = []
    for i in candidates:
        if i.status != "open":
            skipped.append(f"{i.short_id}: {i.status}")
        elif i.owner and i.owner != me:
            skipped.append(f"{i.short_id}: owned by {i.owner}")
        else:
            issues.append(i)
    if args.only:
        wanted = {r.split("#")[-1] for r in args.only.split(",")}
        skipped += [f"{i.short_id}: not in --only" for i in issues if i.short_id not in wanted]
        issues = [i for i in issues if i.short_id in wanted]
    if args.interactive and len(issues) > 1 and not args.only and args.count is None:
        chosen = pick(issues)
        if args.refs:  # picking from the whole backlog: unpicked issues aren't news
            skipped += [f"{i.short_id}: deselected" for i in issues if i not in chosen]
        issues = chosen
    if args.count is not None:
        skipped += [f"{i.short_id}: beyond --count" for i in issues[args.count:]]
        issues = issues[: args.count]

    branch_tpl = git_config(repo, "kdispatch.branch", "{short_id}-{slug}")
    title_tpl = git_config(repo, "kdispatch.prTitle", "{title}")
    targets, base = [], default
    for i in issues:
        branch = render(branch_tpl, i)
        if run(["git", "check-ref-format", "--branch", branch], repo, check=False).returncode != 0:
            raise DispatchError(f"{i.short_id}: `{branch}` is not a valid branch name")
        targets.append(Target(i, branch, render(title_tpl, i), base))
        if stacked:
            base = targets[-1].branch
    return targets, stacked, skipped


# ── git / gh ─────────────────────────────────────────────────────────────────


def default_branch(repo: Path) -> str:
    proc = run(["git", "symbolic-ref", "--short", "refs/remotes/origin/HEAD"], repo, check=False)
    if proc.returncode == 0 and proc.stdout.strip():
        return proc.stdout.strip().removeprefix("origin/")
    return out(["gh", "repo", "view", "--json", "defaultBranchRef", "-q", ".defaultBranchRef.name"], repo)


def create_branch(repo: Path, t: Target, base_rev: str) -> None:
    """Create t.branch as one empty commit on top of base_rev, without a checkout."""
    if run(["git", "show-ref", "--verify", "--quiet", f"refs/heads/{t.branch}"], repo, check=False).returncode == 0:
        log(f"  branch {t.branch} exists, reusing it")
        return
    tree = out(["git", "rev-parse", f"{base_rev}^{{tree}}"], repo)
    commit = out(["git", "commit-tree", tree, "-p", base_rev, "-m", f"wip: {t.issue.short_id} {t.issue.title}"], repo)
    run(["git", "branch", t.branch, commit], repo)


def open_draft_pr(repo: Path, t: Target, stacked: bool) -> None:
    existing = json.loads(out(["gh", "pr", "list", "--head", t.branch, "--state", "open",
                               "--json", "url,baseRefName"], repo) or "[]")
    if existing:
        t.pr_url = existing[0]["url"]
        if existing[0]["baseRefName"] != t.base:
            log(f"  warning: existing PR {t.pr_url} targets {existing[0]['baseRefName']}, not {t.base}")
        return
    body = f"Work in progress for kata issue `{t.issue.ref}`." + (f" Stacked on `{t.base}`." if stacked else "")
    t.pr_url = out(["gh", "pr", "create", "--draft", "--head", t.branch, "--base", t.base,
                    "--title", t.pr_title, "--body", body], repo).splitlines()[-1]


# ── kwt / tmux / claude ──────────────────────────────────────────────────────


def ensure_worktree(repo: Path, t: Target) -> str:
    proc = run([KWT, "get", t.branch], repo, check=False)
    path = proc.stdout.strip()
    if proc.returncode != 0 or not path or not Path(path).is_dir():
        run([KWT, "add", t.branch, "--no-launch"], repo)
        path = out([KWT, "get", t.branch], repo)
    return path


def start_session(repo: Path, t: Target, worktree: str) -> None:
    # --start-session is the only mode of `kwt open` that never attaches the
    # calling terminal. kwt runs its own tmux server, so the endpoint comes from
    # its JSON rather than from `tmux ls`.
    # Creating a workspace occasionally fails transiently inside kwt ("respawn pane
    # failed: fork failed"); --start-session is idempotent, so retry.
    for attempt in range(3):
        try:
            endpoint = json.loads(out([KWT, "open", worktree, "--start-session", "--json"], repo))
            break
        except DispatchError:
            if attempt == 2:
                raise
            time.sleep(1 + attempt)
    t.session, t.socket = endpoint.get("session_name", ""), endpoint.get("tmux_socket_name", "")
    if not t.session or not t.socket:
        raise DispatchError(f"kwt open returned no tmux endpoint: {endpoint}")


def build_prompt(repo: Path, t: Target, stacked: bool, default: str) -> str:
    lines = [
        f"Work on kata issue {t.issue.ref}:",
        "",
        out(["kata", "show", t.issue.ref, "--agent"], repo),
        "",
        "---",
        f"A draft pull request is already open for this branch: {t.pr_url} (base `{t.base}`).",
        "Do not open a new PR and do not change its base.",
    ]
    if stacked and t.base != default:
        lines.append(f"It is stacked on `{t.base}` as part of a multi-PR dependency chain — "
                     f"do not rebase it onto `{default}`.")
    lines.append("When the implementation is complete and tests pass, push your commits to this "
                 "branch and run `gh pr ready` on the existing PR, adding a summary comment of "
                 "what changed and why.")
    return "\n".join(lines) + "\n"


def launch_claude(repo: Path, t: Target, worktree: str, prompt: str) -> None:
    # kwt (and Ghosthub) run tmux with TMUX_TMPDIR unset; honouring it here would
    # address a different server than the one holding the workspace.
    tmux = ["env", "-u", "TMUX_TMPDIR", "tmux", "-L", t.socket]

    def pane_command() -> str:
        return out([*tmux, "display-message", "-p", "-t", t.session, "#{pane_current_command}"], repo)

    current = pane_command()
    if current not in SHELLS:
        t.launched = f"already running ({current})"
        return
    # The prompt lives outside the worktree so nothing from the dispatch can be
    # committed, and the keystrokes stay short and free of quoting problems.
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    prompt_file = STATE_DIR / f"{t.issue.ref.replace('#', '-')}.md"
    prompt_file.write_text(prompt)
    claude = os.environ.get("KDISPATCH_CLAUDE", "claude")
    # The pane's shell can start outside the worktree: it inherits the tmux
    # server's cwd, which may be a since-deleted directory, and Claude refuses
    # to start there. cd explicitly rather than trusting the pane.
    cmd = (f'cd {shlex.quote(worktree)} && '
           f'{claude} --permission-mode auto "$(cat {shlex.quote(str(prompt_file))})"')
    run([*tmux, "send-keys", "-t", t.session, "-l", cmd], repo)
    run([*tmux, "send-keys", "-t", t.session, "Enter"], repo)

    # Keystrokes landing is not a launch: wait for Claude to take over the pane
    # and still be there a moment later, so an immediate exit is reported.
    deadline = time.monotonic() + LAUNCH_TIMEOUT
    while pane_command() in SHELLS and time.monotonic() < deadline:
        time.sleep(0.5)
    if pane_command() not in SHELLS:
        time.sleep(LAUNCH_SETTLE)
    if pane_command() in SHELLS:
        tail = out([*tmux, "capture-pane", "-p", "-t", t.session], repo).strip().splitlines()[-5:]
        raise DispatchError("Claude exited right after launch; pane shows:\n        "
                            + "\n        ".join(tail))
    t.launched = "launched"


# ── main ─────────────────────────────────────────────────────────────────────


def report(targets: list[Target], skipped: list[str]) -> None:
    for t in targets:
        status = f"ERROR: {t.error}" if t.error else t.launched or "not launched"
        click.echo(f"{t.issue.short_id}  {t.branch}  ← {t.base}")
        click.echo(f"      pr: {t.pr_url or '-'}")
        click.echo(f"      tmux: {t.session or '-'} (socket {t.socket or '-'})  claude: {status}")
    for s in skipped:
        click.echo(f"skipped {s}")


@click.command(context_settings={"help_option_names": ["-h", "--help"]})
@click.argument("refs", nargs=-1)
@click.option("--stack", is_flag=True, help="Stack several refs in the order given.")
@click.option("--no-stack", is_flag=True, help="Dispatch a parent's children independently.")
@click.option("--only", help="Comma-separated child refs to dispatch.")
@click.option("--count", type=int, help="Dispatch at most N issues.")
@click.option("--dry-run", is_flag=True, help="Print the plan and change nothing.")
@click.option("--yes", "-y", is_flag=True, help="Don't ask for confirmation.")
@click.option("--no-launch", is_flag=True, help="Set everything up but don't start Claude.")
@click.option("-C", "repo", default=".", type=click.Path(exists=True, file_okay=False),
              help="Repository to run in (default: cwd).")
def main(**opts) -> None:
    """Dispatch kata issues to background kwt workspaces running Claude.

    With no REFS, pick from the repo's open, unclaimed issues. A ref with
    children dispatches its children as a stack of PRs; several refs are
    dispatched independently unless --stack is given. In a terminal, asks
    which issues to dispatch whenever there is more than one candidate.
    """
    sys.exit(dispatch(SimpleNamespace(**opts, interactive=sys.stdin.isatty())))


def dispatch(args) -> int:
    try:
        repo = Path(out(["git", "rev-parse", "--show-toplevel"], Path(args.repo)))
        default = default_branch(repo)
        targets, stacked, skipped = plan(args, repo, default)
    except DispatchError as e:
        log(f"kdispatch: {e}")
        return 1

    if not targets:
        log("Nothing to dispatch.")
        for s in skipped:
            log(f"  skip {s}")
        return 1
    log(f"Plan ({'stacked' if stacked else 'independent'}, default branch `{default}`):")
    for t in targets:
        log(f"  {t.issue.short_id}  {t.branch}  ← {t.base}")
        if t.pr_title != t.issue.title:
            log(f"        PR: {t.pr_title}")
    for s in skipped:
        log(f"  skip {s}")
    if args.dry_run:
        return 0
    if not args.yes:
        if not args.interactive:
            log("kdispatch: not a terminal — pass --yes to confirm")
            return 1
        if not click.confirm("Proceed?", default=True, err=True):
            return 1

    # Phase 1: claim, branch, push and open the draft PR for each issue, in
    # order. Any failure (including losing a claim race) aborts the rest, since
    # a stack can't skip a link; re-run once it's resolved.
    me = kata_actor()
    for n, t in enumerate(targets):
        try:
            if n == 0:
                run(["git", "fetch", "origin", default], repo)
            log(f"→ {t.issue.short_id}: {t.branch}")
            if t.issue.owner != me:
                kata_json(["claim", t.issue.ref], repo)
            create_branch(repo, t, f"origin/{default}" if t.base == default else t.base)
            run(["git", "push", "-u", "origin", t.branch], repo)
            open_draft_pr(repo, t, stacked)
        except DispatchError as e:
            t.error = str(e)
            report(targets[: n + 1], skipped + [f"{r.issue.short_id}: not reached" for r in targets[n + 1:]])
            return 1

    if stacked and len(targets) > 1:
        proc = run(["gh", "stack", "link", "--base", default, *[t.pr_url for t in targets]], repo, check=False)
        if proc.returncode != 0:
            log(f"  warning: PRs are chained by base branch but `gh stack link` failed "
                f"(is gh-stack installed?): {(proc.stderr or proc.stdout).strip()}")

    # Phase 2: worktree, detached session and Claude for each issue. Failures
    # here are per-issue.
    for t in targets:
        try:
            worktree = ensure_worktree(repo, t)
            start_session(repo, t, worktree)
            if not args.no_launch:
                launch_claude(repo, t, worktree, build_prompt(repo, t, stacked, default))
        except DispatchError as e:
            t.error = str(e)

    report(targets, skipped)
    return 1 if any(t.error for t in targets) else 0


if __name__ == "__main__":
    main()
