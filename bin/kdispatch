#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["click>=8.1"]
# ///
#
# kdispatch — dispatch kata issues to background kwt workspaces running Claude.
#
# For every issue it dispatches it: claims the issue, creates a branch with an
# empty "wip" commit (without checking anything out), pushes it, opens a draft PR,
# attaches a kwt worktree, starts the tmux workspace detached, and launches
# `claude --permission-mode auto` in it with the issue as the prompt.
#
# Usage:
#   kdispatch                     pick from the repo's open, unclaimed issues
#   kdispatch <ref>               issue without children → dispatch just that issue
#                                 issue with children    → dispatch its children as a stack
#   kdispatch <ref> <ref> ...     several independent issues, each based on the default branch
#   kdispatch --stack <ref> ...   several issues stacked in the order given
#
# In a terminal, whenever there is more than one candidate issue it asks which to
# dispatch. Run it from the repository the issues belong to. Re-running is safe: claims,
# branches, PRs, worktrees and sessions that already exist are reused, and Claude
# is only launched into a session whose pane is sitting at a shell prompt.
#
# KDISPATCH_CLAUDE overrides the command launched in each workspace (default: claude).

import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass, field
from pathlib import Path
from types import SimpleNamespace

import click

SHELLS = {"zsh", "bash", "fish", "sh", "dash", "ksh"}
GHOSTHUB_KWT = "/Applications/Ghosthub.app/Contents/Helpers/kwt"
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")) / "kdispatch"


class DispatchError(Exception):
    pass


def run(args: list[str], cwd: Path, *, check: bool = True) -> subprocess.CompletedProcess:
    proc = subprocess.run(args, cwd=cwd, capture_output=True, text=True, stdin=subprocess.DEVNULL)
    if check and proc.returncode != 0:
        detail = (proc.stderr or proc.stdout).strip()
        raise DispatchError(f"`{shlex.join(args)}` failed: {detail}")
    return proc


def out(args: list[str], cwd: Path) -> str:
    return run(args, cwd).stdout.strip()


def log(msg: str) -> None:
    click.echo(msg, err=True)


# ── kata ─────────────────────────────────────────────────────────────────────


@dataclass
class Issue:
    ref: str            # qualified ref when known (project#short), else as given
    short_id: str
    title: str
    status: str
    owner: str | None
    children: list[str] = field(default_factory=list)


def kata_json(args: list[str], cwd: Path) -> dict:
    proc = run(["kata", *args, "--json"], cwd, check=False)
    data: dict = {}
    for stream in (proc.stdout, proc.stderr):
        try:
            data = json.loads(stream)
            break
        except json.JSONDecodeError:
            continue
    if proc.returncode != 0 or "error" in data:
        msg = data.get("error", {}).get("message") or (proc.stderr or proc.stdout).strip()
        raise DispatchError(f"kata {' '.join(args)}: {msg}")
    return data


def load_issue(ref: str, cwd: Path) -> Issue:
    data = kata_json(["show", ref], cwd)
    issue = data["issue"]
    # Children are links of type "parent" pointing *at* this issue; link ids keep
    # them in creation order, which is how objective children are numbered.
    child_links = sorted(
        (l for l in data.get("links") or []
         if l.get("type") == "parent" and l["to"]["uid"] == issue["uid"]),
        key=lambda l: l["id"],
    )
    qualified = ref
    for l in data.get("links") or []:
        for end in (l["from"], l["to"]):
            if end["uid"] == issue["uid"]:
                qualified = end["qualified_id"]
    return Issue(
        ref=qualified,
        short_id=issue["short_id"],
        title=issue["title"],
        status=issue["status"],
        owner=issue.get("owner"),
        children=[l["from"]["qualified_id"] for l in child_links],
    )


def kata_actor() -> str:
    return os.environ.get("KATA_AUTHOR") or os.environ.get("USER") or ""


# ── planning ─────────────────────────────────────────────────────────────────


@dataclass
class Target:
    issue: Issue
    branch: str
    base: str = ""
    pr_url: str = ""
    worktree: str = ""
    session: str = ""
    socket: str = ""
    launched: str = ""   # "launched" | "already running" | ""
    error: str = ""


def slugify(title: str) -> str:
    slug = re.sub(r"[^a-z0-9 -]", "", title.lower()).strip().replace(" ", "-")
    slug = re.sub(r"-{2,}", "-", slug)
    return slug[:40].rstrip("-")


def branch_name(issue: Issue) -> str:
    return f"{issue.short_id}-{slugify(issue.title)}"


def parse_selection(raw: str, n: int) -> list[int]:
    if not raw.strip():
        return list(range(n))
    picked: list[int] = []
    for part in raw.replace(" ", "").split(","):
        lo, _, hi = part.partition("-")
        for i in range(int(lo), int(hi or lo) + 1):
            if not 1 <= i <= n:
                raise ValueError(f"{i} is out of range")
            if i - 1 not in picked:
                picked.append(i - 1)
    return sorted(picked)


def pick(issues: list[Issue]) -> list[Issue]:
    for i, issue in enumerate(issues, 1):
        log(f"  {i:>2}. {issue.short_id}  {issue.title}")
    while True:
        raw = click.prompt("Dispatch which? (e.g. 1,3-4; empty = all)", default="",
                           show_default=False, err=True)
        try:
            return [issues[i] for i in parse_selection(raw, len(issues))]
        except ValueError as e:
            log(f"  invalid selection: {e}")


def plan(args, repo: Path) -> tuple[list[Target], bool, list[str]]:
    """Return (targets in dispatch order, stacked?, skipped-ref notes)."""
    me = kata_actor()
    skipped: list[str] = []

    def eligible(issue: Issue) -> bool:
        if issue.status != "open":
            skipped.append(f"{issue.short_id}: {issue.status}")
            return False
        if issue.owner and issue.owner != me:
            skipped.append(f"{issue.short_id}: owned by {issue.owner}")
            return False
        return True

    if not args.refs:
        if not args.interactive:
            raise DispatchError("no issue refs given (interactive selection needs a terminal)")
        listed = kata_json(["list", "--unowned"], repo).get("issues") or []
        roots = [Issue(ref=i["qualified_id"], short_id=i["short_id"], title=i["title"],
                       status=i["status"], owner=i.get("owner")) for i in listed]
        if not roots:
            raise DispatchError("no open, unclaimed issues in this repo's kata project")
    else:
        roots = [load_issue(r, repo) for r in args.refs]
    if len(roots) == 1 and roots[0].children:
        stacked = not args.no_stack
        candidates = [load_issue(c, repo) for c in roots[0].children]
    else:
        stacked = args.stack
        candidates = roots

    issues = [i for i in candidates if eligible(i)]
    if args.only:
        wanted = {r.split("#")[-1] for r in args.only.split(",")}
        for i in issues:
            if i.short_id not in wanted:
                skipped.append(f"{i.short_id}: not in --only")
        issues = [i for i in issues if i.short_id in wanted]
    if args.interactive and len(issues) > 1 and not args.only and args.count is None:
        chosen = pick(issues)
        if args.refs:  # picking from the whole backlog: unpicked issues aren't news
            skipped += [f"{i.short_id}: deselected" for i in issues if i not in chosen]
        issues = chosen
    if args.count is not None:
        skipped += [f"{i.short_id}: beyond --count" for i in issues[args.count:]]
        issues = issues[: args.count]
    return [Target(i, branch_name(i)) for i in issues], stacked, skipped


# ── git / gh ─────────────────────────────────────────────────────────────────


def default_branch(repo: Path) -> str:
    proc = run(["git", "symbolic-ref", "--short", "refs/remotes/origin/HEAD"], repo, check=False)
    if proc.returncode == 0 and proc.stdout.strip():
        return proc.stdout.strip().removeprefix("origin/")
    return out(["gh", "repo", "view", "--json", "defaultBranchRef", "-q", ".defaultBranchRef.name"], repo)


def branch_exists(repo: Path, branch: str) -> bool:
    return run(["git", "show-ref", "--verify", "--quiet", f"refs/heads/{branch}"], repo, check=False).returncode == 0


def create_branch(repo: Path, t: Target, base_rev: str) -> None:
    """Create t.branch as one empty commit on top of base_rev, without a checkout."""
    if branch_exists(repo, t.branch):
        log(f"  branch {t.branch} exists, reusing it")
        return
    tree = out(["git", "rev-parse", f"{base_rev}^{{tree}}"], repo)
    msg = f"wip: {t.issue.short_id} {t.issue.title}"
    commit = out(["git", "commit-tree", tree, "-p", base_rev, "-m", msg], repo)
    run(["git", "branch", t.branch, commit], repo)


def open_draft_pr(repo: Path, t: Target, stacked: bool) -> None:
    existing = json.loads(out(["gh", "pr", "list", "--head", t.branch, "--state", "open",
                               "--json", "url,baseRefName"], repo) or "[]")
    if existing:
        t.pr_url = existing[0]["url"]
        if existing[0]["baseRefName"] != t.base:
            log(f"  warning: existing PR {t.pr_url} targets {existing[0]['baseRefName']}, not {t.base}")
        return
    body = f"Work in progress for kata issue `{t.issue.ref}`."
    if stacked:
        body += f" Stacked on `{t.base}`."
    t.pr_url = out(["gh", "pr", "create", "--draft", "--head", t.branch, "--base", t.base,
                    "--title", t.issue.title, "--body", body], repo).splitlines()[-1]


def gh_stack_available(repo: Path) -> bool:
    proc = run(["gh", "extension", "list"], repo, check=False)
    return any(line.split("\t")[0].strip() == "gh stack" for line in proc.stdout.splitlines())


# ── kwt / tmux / claude ──────────────────────────────────────────────────────


def find_kwt() -> str | None:
    # kwt is often only a shell alias to the copy bundled with Ghosthub.
    if shutil.which("kwt"):
        return "kwt"
    return GHOSTHUB_KWT if os.access(GHOSTHUB_KWT, os.X_OK) else None


KWT = find_kwt() or "kwt"


def ensure_worktree(repo: Path, t: Target) -> None:
    proc = run([KWT, "get", t.branch], repo, check=False)
    path = proc.stdout.strip()
    if proc.returncode != 0 or not path or not Path(path).is_dir():
        run([KWT, "add", t.branch, "--no-launch"], repo)
        path = out([KWT, "get", t.branch], repo)
    t.worktree = path


def start_session(repo: Path, t: Target) -> None:
    # --start-session is the only mode of `kwt open` that never attaches the
    # calling terminal. kwt runs its own tmux server, so the endpoint comes from
    # its JSON rather than from `tmux ls`.
    # Creating a workspace occasionally fails transiently inside kwt ("respawn pane
    # failed: fork failed"); --start-session is idempotent, so retry.
    for attempt in range(3):
        try:
            endpoint = json.loads(out([KWT, "open", t.worktree, "--start-session", "--json"], repo))
            break
        except DispatchError:
            if attempt == 2:
                raise
            time.sleep(1 + attempt)
    t.session, t.socket = endpoint.get("session_name", ""), endpoint.get("tmux_socket_name", "")
    if not t.session or not t.socket:
        raise DispatchError(f"kwt open returned no tmux endpoint: {endpoint}")


def build_prompt(repo: Path, t: Target, stacked: bool, default: str) -> str:
    issue_text = out(["kata", "show", t.issue.ref, "--agent"], repo)
    lines = [
        f"Work on kata issue {t.issue.ref}:",
        "",
        issue_text,
        "",
        "---",
        f"A draft pull request is already open for this branch: {t.pr_url} (base `{t.base}`).",
        "Do not open a new PR and do not change its base.",
    ]
    if stacked and t.base != default:
        lines.append(f"It is stacked on `{t.base}` as part of a multi-PR dependency chain — "
                     f"do not rebase it onto `{default}`.")
    lines.append("When the implementation is complete and tests pass, push your commits to this "
                 "branch and run `gh pr ready` on the existing PR, adding a summary comment of "
                 "what changed and why.")
    return "\n".join(lines) + "\n"


def tmux(socket: str) -> list[str]:
    # kwt (and Ghosthub) run tmux with TMUX_TMPDIR unset; honouring it here would
    # address a different server than the one holding the workspace.
    return ["env", "-u", "TMUX_TMPDIR", "tmux", "-L", socket]


def launch_claude(repo: Path, t: Target, prompt: str) -> None:
    current = out([*tmux(t.socket), "display-message", "-p", "-t", t.session, "#{pane_current_command}"], repo)
    if current not in SHELLS:
        t.launched = f"already running ({current})"
        return
    # The prompt lives outside the worktree so nothing from the dispatch can be
    # committed, and the keystrokes stay short and free of quoting problems.
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    prompt_file = STATE_DIR / f"{t.issue.ref.replace('#', '-')}.md"
    prompt_file.write_text(prompt)
    claude = os.environ.get("KDISPATCH_CLAUDE", "claude")
    cmd = f'{claude} --permission-mode auto "$(cat {shlex.quote(str(prompt_file))})"'
    run([*tmux(t.socket), "send-keys", "-t", t.session, "-l", cmd], repo)
    run([*tmux(t.socket), "send-keys", "-t", t.session, "Enter"], repo)
    t.launched = "launched"


# ── main ─────────────────────────────────────────────────────────────────────


def print_plan(targets: list[Target], stacked: bool, default: str, skipped: list[str]) -> None:
    log(f"Plan ({'stacked' if stacked else 'independent'}, default branch `{default}`):")
    prev = default
    for t in targets:
        base = prev if stacked else default
        log(f"  {t.issue.short_id}  {t.branch}  ← {base}")
        if stacked:
            prev = t.branch
    for s in skipped:
        log(f"  skip {s}")


def report(targets: list[Target], skipped: list[str], as_json: bool) -> None:
    if as_json:
        print(json.dumps({
            "dispatched": [{
                "ref": t.issue.ref, "title": t.issue.title, "branch": t.branch, "base": t.base,
                "pr": t.pr_url, "worktree": t.worktree, "session": t.session,
                "tmux_socket": t.socket, "claude": t.launched, "error": t.error,
            } for t in targets],
            "skipped": skipped,
        }, indent=2))
        return
    for t in targets:
        status = f"ERROR: {t.error}" if t.error else t.launched or "not launched"
        print(f"{t.issue.short_id}  {t.branch}  ← {t.base}")
        print(f"      pr: {t.pr_url or '-'}")
        print(f"      tmux: {t.session or '-'} (socket {t.socket or '-'})  claude: {status}")
    for s in skipped:
        print(f"skipped {s}")


@click.command(context_settings={"help_option_names": ["-h", "--help"]})
@click.argument("refs", nargs=-1)
@click.option("--stack", is_flag=True, help="Stack several refs in the order given.")
@click.option("--no-stack", is_flag=True, help="Dispatch a parent's children independently.")
@click.option("--only", help="Comma-separated child refs to dispatch.")
@click.option("--count", type=int, help="Dispatch at most N issues.")
@click.option("--dry-run", is_flag=True, help="Print the plan and change nothing.")
@click.option("--yes", "-y", is_flag=True, help="Don't ask for confirmation.")
@click.option("--no-launch", is_flag=True, help="Set everything up but don't start Claude.")
@click.option("--json", "as_json", is_flag=True, help="Print the result as JSON.")
@click.option("-C", "repo", default=".", type=click.Path(exists=True, file_okay=False),
              help="Repository to run in (default: cwd).")
def main(**opts) -> None:
    """Dispatch kata issues to background kwt workspaces running Claude.

    With no REFS, pick from the repo's open, unclaimed issues. A ref with
    children dispatches its children as a stack of PRs; several refs are
    dispatched independently unless --stack is given.
    """
    args = SimpleNamespace(**opts, interactive=sys.stdin.isatty())
    sys.exit(dispatch(args))


def dispatch(args) -> int:
    for tool in ("git", "gh", "kata", "tmux"):
        if not shutil.which(tool):
            log(f"kdispatch: `{tool}` not found on PATH")
            return 1
    if not find_kwt():
        log(f"kdispatch: `kwt` not found on PATH or at {GHOSTHUB_KWT}")
        return 1

    try:
        repo = Path(out(["git", "rev-parse", "--show-toplevel"], Path(args.repo)))
        targets, stacked, skipped = plan(args, repo)
        default = default_branch(repo)
    except DispatchError as e:
        log(f"kdispatch: {e}")
        return 1

    if not targets:
        log("Nothing to dispatch.")
        for s in skipped:
            log(f"  skip {s}")
        return 1
    print_plan(targets, stacked, default, skipped)
    if args.dry_run:
        return 0
    if not args.yes:
        if not args.interactive:
            log("kdispatch: not a terminal — pass --yes to confirm")
            return 1
        if not click.confirm("Proceed?", default=True, err=True):
            return 1

    me = kata_actor()
    prev_branch = ""
    dispatched: list[Target] = []
    # Phase 1: claim, branch, push and open the draft PR for each issue, in
    # order. In a stack each branch builds on the previous one, so a failure
    # here stops the rest.
    for n, t in enumerate(targets):
        try:
            if n == 0:
                run(["git", "fetch", "origin", default], repo)
            if t.issue.owner != me:
                try:
                    kata_json(["claim", t.issue.ref], repo)
                except DispatchError as e:
                    skipped.append(f"{t.issue.short_id}: claim failed ({e})")
                    continue
            log(f"→ {t.issue.short_id}: {t.branch}")
            t.base = prev_branch if stacked and prev_branch else default
            create_branch(repo, t, t.base if t.base != default else f"origin/{default}")
            run(["git", "push", "-u", "origin", t.branch], repo)
            open_draft_pr(repo, t, stacked)
        except DispatchError as e:
            t.error = str(e)
            skipped += [f"{r.issue.short_id}: not reached" for r in targets[n + 1:]]
            report([*dispatched, t], skipped, args.as_json)
            return 1
        dispatched.append(t)
        prev_branch = t.branch

    if stacked and len(dispatched) > 1:
        if gh_stack_available(repo):
            proc = run(["gh", "stack", "link", "--base", default, *[t.pr_url for t in dispatched]],
                       repo, check=False)
            if proc.returncode != 0:
                log(f"  warning: gh stack link failed: {(proc.stderr or proc.stdout).strip()}")
        else:
            log("  gh-stack not installed: PRs are chained by base branch but not linked as a stack")

    # Phase 2: worktree, detached session and Claude for each issue. Failures
    # here are per-issue.
    for t in dispatched:
        try:
            ensure_worktree(repo, t)
            start_session(repo, t)
            if not args.no_launch:
                launch_claude(repo, t, build_prompt(repo, t, stacked, default))
        except DispatchError as e:
            t.error = str(e)

    report(dispatched, skipped, args.as_json)
    return 1 if any(t.error for t in dispatched) else 0


if __name__ == "__main__":
    main()
